<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 被拒絕的麥克風在 macOS 上不會報錯，它直接發數位靜音（coreaudiod:
	     "Client is not granted access to the input device"）—— getUserMedia
	     成功、取樣照流、值全是 0，一路走到 whisper 才變成 empty transcript。
	     這個鍵只對 dev 的裸執行檔有意義，而且只是必要條件不是充分條件；打包的
	     .app 由 tauri.conf.json 自動帶入 bundle identifier，那裡它是冗餘的。
	     實測可用的路徑是
	     打包的 .app 再加上 codesign --force --sign - --identifier
	     dev.musingfox.shikigami；未簽章的 dev 裸執行檔，簽章識別碼是
	     shikigami-<cargo fingerprint>，每次重編都變，光有這個鍵仍然沒有穩定
	     的授權主體。值必須與 tauri.conf.json 的 identifier 一致，日後要改記
	     得兩邊一起。 -->
	<key>CFBundleIdentifier</key>
	<string>dev.musingfox.shikigami</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Shikigami uses the microphone for push-to-talk voice commands (Cmd+Ctrl+M). Audio stays on-device for Whisper STT.</string>
</dict>
</plist>
